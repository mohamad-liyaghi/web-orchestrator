# Copy to .env and adjust. Every value has a default in docker-compose.yml.

# IPs and/or hostnames (comma-separated) the self-signed certificate is issued for.
# Set it to your server's public IP or hostname in a local .env (never commit .env).
PUBLIC_HOST=localhost

# Public HTTPS port (container 8443).
HTTPS_PORT=8443

# Plain HTTP for a reverse proxy, published on 127.0.0.1 only (container 8080).
HTTP_PORT=8088

# Directory with a real certificate (fullchain.pem + privkey.pem). Leave it empty for self-signed.
TLS_CERT_DIR=./deploy/certs

# Tag for the built image (web-orchestrator:<tag>).
IMAGE_TAG=latest
